# Enable Git LFS before intentionally adding model binaries:
#   git lfs install
#   git lfs track "*.pt" "*.pth" "*.onnx" "*.hef" "*.engine"
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.hef filter=lfs diff=lfs merge=lfs -text
*.engine filter=lfs diff=lfs merge=lfs -text

*.py text eol=lf
*.ino text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
